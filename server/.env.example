# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database connection template (Do not store real credentials here)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mindmesh?retryWrites=true&w=majority

# Authentication secret (Generate a strong random string in your server .env)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
